# Copia este archivo a .env y ajusta lo que necesites.
# Los valores por defecto funcionan tal cual con `docker compose up`.
# Para ejecutar fuera de Docker, cambia qdrant/ollama/api por localhost en las URLs.

# --- Scraping ---
SCRAPER_BASE_URL=https://www.bbva.com.co
SCRAPER_SITEMAP_URL=https://www.bbva.com.co/sitemap.xml
SCRAPER_MAX_PAGES=150
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT=rag-bank-assistant/0.1 (prueba tecnica; uso educativo)
# Páginas con menos texto útil que esto se descartan al limpiar
SCRAPER_MIN_TEXT_CHARS=200
RAW_DATA_DIR=data/raw
CLEAN_DATA_DIR=data/clean

# --- Chunking (en caracteres) ---
# El modelo de embeddings por defecto lee máximo 128 tokens (~550 caracteres):
# chunks más largos se truncarían en silencio al vectorizar.
CHUNK_SIZE=450
CHUNK_OVERLAP=70

# --- Embeddings y reranker (fastembed / ONNX, multilingües) ---
# Alternativa de mayor calidad y ~7x más lenta en CPU (512 tokens, 768 dims):
#   EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es  con  CHUNK_SIZE=1500
EMBEDDER_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RERANKER_PROVIDER=none desactiva el reranking
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
EMBEDDING_BATCH_SIZE=32
# Carpeta donde fastembed guarda los modelos descargados
MODEL_CACHE_DIR=data/models

# --- Base de datos vectorial ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bank_site
QDRANT_TIMEOUT_SECONDS=30

# --- Recuperación ---
# TOP_K: candidatos traídos de Qdrant. RERANK_TOP_N: los que llegan al LLM.
TOP_K=20
RERANK_TOP_N=5
# Si el mejor puntaje del reranker (0-1) queda por debajo, se responde
# "no encontré información" sin llamar al LLM.
MIN_RERANK_SCORE=0.15

# --- LLM ---
# LLM_PROVIDER: ollama (local, por defecto) | groq (requiere GROQ_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Ventana de contexto que se pide a Ollama (tokens)
OLLAMA_NUM_CTX=8192
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512

# --- Historial de conversación ---
HISTORY_DB_PATH=data/history/history.db
# N mensajes previos de la sesión usados para condensar la pregunta
HISTORY_MAX_MESSAGES=6

# --- Analítica ---
# Minutos que tomaría resolver una consulta buscando manualmente en el sitio
MANUAL_SEARCH_MINUTES=5

# --- API / UI ---
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000
LOG_LEVEL=INFO
